# Copy this file to .env and fill in real values. Never commit the real .env.

NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# --- Database (Postgres) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=pakmaps
DB_USER=pakmaps
DB_PASSWORD=change_me
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- Redis (cache, queues, rate limiting) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN_WEB=7d
JWT_EXPIRES_IN_MOBILE=30d
COOKIE_NAME=pakmaps_jwt
BCRYPT_SALT_ROUNDS=12

# --- Default admin bootstrap ---
# Used once, only if the users table is empty, to create the first admin account.
DEFAULT_ADMIN_NAME=Super Admin
DEFAULT_ADMIN_EMAIL=admin@pakmaps.pk
DEFAULT_ADMIN_PASSWORD=change_me_now

# --- CORS / proxy trust ---
ADMIN_PANEL_ORIGIN=http://localhost:5173
TRUST_PROXY=loopback

# --- Rate limiting (global default; per-service override lives in the api_services table) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# --- Upstream geo service base URLs (seed defaults; editable later from the admin panel) ---
TILE_SERVER_BASE_URL=https://tiles.internal.example
GEOCODER_BASE_URL=https://geocoder.internal.example
ROUTING_BASE_URL=https://routing.internal.example
DEM_BASE_URL=https://dem.internal.example

# --- Frontend build (used by docker-compose to bake the admin panel's API base URL) ---
ADMIN_PANEL_VITE_API_URL=http://localhost:5000/api
